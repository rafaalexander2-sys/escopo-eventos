# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Domínio raiz da plataforma
VITE_ROOT_DOMAIN=plataforma.com.br

# Desenvolvimento local — escolha a camada que quer testar
# Valores possíveis: landing | admin | portal
VITE_APP_MODE=admin

# Quando VITE_APP_MODE=portal, define o slug do tenant simulado
VITE_DEV_SLUG=meu-evento
